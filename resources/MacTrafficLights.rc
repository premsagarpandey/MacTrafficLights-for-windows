#include "../include/Resource.h"
#include <windows.h>

// Application icon
IDI_APP_ICON ICON "app.ico"

// DPI awareness & Windows 11 compatibility manifest
1 24 "app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MacTrafficLights"
            VALUE "FileDescription",  "MacTrafficLights Native Window Controls for Windows 11"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MacTrafficLights"
            VALUE "LegalCopyright",   "Copyright (c) 2026"
            VALUE "OriginalFilename", "MacTrafficLights.exe"
            VALUE "ProductName",      "MacTrafficLights"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
